.venv/
firmware/
docs/
tests/
tools/
scripts/
runtime/
node_modules/
**/__pycache__/
**/*.pyc
*.egg-info/
.pytest_cache/
.git/
.env
.env.*
!.env.example
.agents/
.doubaoadk/
.superpowers/
.claude/
deploy/.env
