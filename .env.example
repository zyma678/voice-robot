# Copy this file to .env and fill in the values for your environment.
# Never commit .env. Generate shared tokens with: openssl rand -hex 24

# Server
VOICE_ROBOT_AUTH_TOKEN=
VOICE_ROBOT_DEFAULT_USER_ID=default-user
VOICE_ROBOT_LLM_API_KEY=
VOICE_ROBOT_LLM_MODEL=doubao-seed-2-0-mini-260428
VOICE_ROBOT_LLM_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOICE_ROBOT_AUTO_PUBLIC_TUNNEL=false

# Speech services (Volcengine). Empty API keys enable local development fallbacks.
VOICE_ROBOT_SPEECH_MODE=split
VOICE_ROBOT_ASR_API_KEY=
VOICE_ROBOT_ASR_RESOURCE_ID=volc.bigasr.sauc.duration
VOICE_ROBOT_ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
VOICE_ROBOT_ASR_SAMPLE_RATE_HZ=16000
VOICE_ROBOT_TTS_API_KEY=
VOICE_ROBOT_TTS_RESOURCE_ID=seed-tts-1.0
VOICE_ROBOT_TTS_WS_URL=wss://openspeech.bytedance.com/api/v3/tts/unidirectional/stream
VOICE_ROBOT_TTS_SAMPLE_RATE_HZ=16000
VOICE_ROBOT_TTS_ENCODING=pcm
VOICE_ROBOT_TTS_VOICE_TYPE=

# ESP32 firmware. scripts/flash_firmware.sh reads these values automatically.
VR_WIFI_SSID=
VR_WIFI_PASSWORD=
# Optional second network shown in the device settings screen.
VR_WIFI_HOTSPOT_SSID=
VR_WIFI_HOTSPOT_PASSWORD=
VR_WS_URL=
VR_CLOUD_WS_URL=
VR_DEVICE_ID=esp32-001
# Optional override. When empty, VOICE_ROBOT_AUTH_TOKEN is used.
VR_AUTH_TOKEN=
VR_PROV_POP=
VR_BOARD_UI_ENABLE=y
VR_SERIAL_PORT=

# TLS deployment
VR_DOMAIN=

# Optional cloud backup/deployment helpers
VR_DEPLOY_HOST=
VR_DEPLOY_REMOTE_ROOT=/opt/voice-robot
VR_DEPLOY_VOLUME=deploy_vr-runtime
